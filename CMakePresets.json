{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "alpaka_MAV_TESTING": "ON",
        "alpaka_MAV_EXAMPLES": "ON"
      }
    },
    {
      "name": "release-base",
      "inherits": [
        "default"
      ],
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "debug-base",
      "inherits": [
        "default"
      ],
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "cpu-base",
      "hidden": true,
      "cacheVariables": {
        "alpaka_DEP_OMP": "ON"
      }
    },
    {
      "name": "rel-host-gcc",
      "inherits": [
        "release-base",
        "cpu-base"
      ],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
      "name": "rel-host-clang",
      "inherits": [
        "release-base",
        "cpu-base"
      ],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "rel-cuda-nvcc-gcc",
      "inherits": [
        "release-base",
        "cpu-base"
      ],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "alpaka_DEP_CUDA": "ON",
        "alpaka_DEP_OMP": "OFF"
      }
    },
    {
      "name": "rel-cuda-nvcc-clang",
      "inherits": [
        "release-base",
        "cpu-base"
      ],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "alpaka_DEP_CUDA": "ON",
        "alpaka_DEP_OMP": "OFF"
      }
    },
    {
      "name": "rel-cuda-clangCuda",
      "inherits": [
        "release-base",
        "cpu-base"
      ],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CUDA_COMPILER": "clang++",
        "CMAKE_CUDA_HOST_COMPILER": "clang++",
        "alpaka_DEP_CUDA": "ON",
        "alpaka_DEP_OMP": "OFF"
      }
    },
    {
      "name": "rel-hip",
      "inherits": [
        "release-base"
      ],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "alpaka_DEP_HIP": "ON",
        "alpaka_DEP_OMP": "OFF"
      }
    },
    {
      "name": "rel-oneapi",
      "inherits": [
        "release-base"
      ],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "icpx",
        "alpaka_DEP_ONEAPI": "ON",
        "alpaka_DEP_OMP": "OFF"
      }
    },
    {
      "name": "dbg-host-gcc",
      "inherits": [
        "debug-base",
        "cpu-base"
      ],
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++"
      }
    },
    {
